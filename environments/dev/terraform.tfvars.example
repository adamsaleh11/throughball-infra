project_id = "your-gcp-project-id"

# Cost controls: min_instances must remain 0.
min_instances = 0
max_instances = 1

allow_unauthenticated = false

# Secret containers only. Do not put secret values in Terraform variables.
secret_ids = []

cloud_run_services = {
  platform_api = {
    service_name    = "throughball-platform-api"
    container_image = "us-central1-docker.pkg.dev/your-gcp-project-id/throughball/platform-api:dev"
  }
  ai_runtime = {
    service_name    = "throughball-ai-runtime"
    container_image = "us-central1-docker.pkg.dev/your-gcp-project-id/throughball/ai-runtime:dev"
  }
  mcp_server = {
    service_name    = "throughball-mcp-server"
    container_image = "us-central1-docker.pkg.dev/your-gcp-project-id/throughball/mcp-server:dev"
  }
  worker = {
    service_name           = "throughball-worker"
    container_image        = "us-central1-docker.pkg.dev/your-gcp-project-id/throughball/worker:dev"
    liveness_probe_enabled = false
  }
}
